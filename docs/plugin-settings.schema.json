{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LifeOS plugin settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fields"],
  "properties": {
    "version": { "const": 1 },
    "description": { "type": "string" },
    "fields": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "label", "type"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "pattern": "\\S" },
          "type": { "enum": ["text", "secret", "select"] },
          "required": { "type": "boolean", "default": false },
          "default": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } }
        },
        "allOf": [
          { "if": { "properties": { "type": { "const": "select" } } },
            "then": { "required": ["options"], "properties": { "options": { "minItems": 1 } } } },
          { "if": { "properties": { "type": { "const": "secret" } } },
            "then": { "properties": { "default": { "const": "" } } } }
        ]
      }
    }
  }
}

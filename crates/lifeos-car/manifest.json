{
  "$schema": "../../docs/plugin-manifest.schema.json",
  "schemaVersion": 1,
  "version": "1.0.0",
  "description": "Fuel, maintenance and vehicle expenses in VND.",
  "label": "Chi tiêu ô tô",
  "capability": "car",
  "vars": [],
  "tools": [
    {
      "name": "list_expenses",
      "description": "List car expenses for YYYY-MM.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "month": {
            "type": "string"
          }
        },
        "required": [
          "month"
        ],
        "type": "object"
      },
      "effect": "read"
    },
    {
      "name": "save_expense",
      "description": "Create a car expense in VND (omit id), or replace a listed expense by id. When editing, preserve its other fields. Use YYYY-MM-DD for date. Returns the saved id.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "format": "int64",
            "type": "integer"
          },
          "category": {
            "description": "One of fuel, service, repair, parking, toll, insurance, other.",
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "km": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "litres": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "note": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "date",
          "category",
          "amount"
        ],
        "type": "object"
      },
      "effect": "reversible"
    },
    {
      "name": "delete_expense",
      "description": "Delete a car expense by ID.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "effect": "irreversible"
    }
  ],
  "poll": false,
  "accounts": false,
  "signals": [],
  "agents": [],
  "sensorKinds": [],
  "processors": [],
  "subscriptions": [],
  "storage": "vault_database"
}
